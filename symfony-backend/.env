# Local development template. Keep real values in .env.local or the host environment.
APP_ENV=dev
APP_SECRET=replace-with-a-local-secret
FRONTEND_URL=http://localhost:4200
GOOGLE_CLIENT_ID=
MAILER_DSN=null://null
DATABASE_URL="postgresql://user:password@host:5432/database?serverVersion=13&charset=utf8"
MESSENGER_TRANSPORT_DSN=sync://
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=replace-with-a-local-passphrase
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'
